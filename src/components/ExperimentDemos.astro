---
import idSortingPiRed from "../assets/video/experiments/id-sorting-pi-red.mp4";
import idSortingHintRed from "../assets/video/experiments/id-sorting-hint-red.mp4";
import idSortingPiBlue from "../assets/video/experiments/id-sorting-pi-blue.mp4";
import idSortingHintBlue from "../assets/video/experiments/id-sorting-hint-blue.mp4";
import oodSortingPiLeft from "../assets/video/experiments/ood-sorting-pi-left.mp4";
import oodSortingHintLeft from "../assets/video/experiments/ood-sorting-hint-left.mp4";
import oodSortingPiRight from "../assets/video/experiments/ood-sorting-pi-right.mp4";
import oodSortingHintRight from "../assets/video/experiments/ood-sorting-hint-right.mp4";
import idSpellingPiWolf from "../assets/video/experiments/id-spelling-pi-wolf.mp4";
import idSpellingHintWolf from "../assets/video/experiments/id-spelling-hint-wolf.mp4";
import idSpellingPiBox from "../assets/video/experiments/id-spelling-pi-box.mp4";
import idSpellingHintBox from "../assets/video/experiments/id-spelling-hint-box.mp4";
import oodSpellingPiApple from "../assets/video/experiments/ood-spelling-pi-apple.mp4";
import oodSpellingHintApple from "../assets/video/experiments/ood-spelling-hint-apple.mp4";
import oodSpellingPiRobot from "../assets/video/experiments/ood-spelling-pi-robot.mp4";
import oodSpellingHintRobot from "../assets/video/experiments/ood-spelling-hint-robot.mp4";
import idInsertionPiGreen from "../assets/video/experiments/id-insertion-pi-green-rectangle.mp4";
import idInsertionHintGreen from "../assets/video/experiments/id-insertion-hint-green-rectangle.mp4";
import idInsertionPiRedL from "../assets/video/experiments/id-insertion-pi-red-lshape.mp4";
import idInsertionHintRedL from "../assets/video/experiments/id-insertion-hint-red-lshape.mp4";
import oodInsertionPiMiddle from "../assets/video/experiments/ood-insertion-pi-middle-rectangle.mp4";
import oodInsertionHintMiddle from "../assets/video/experiments/ood-insertion-hint-middle-rectangle.mp4";
import oodInsertionPiCircle from "../assets/video/experiments/ood-insertion-pi-red-circle.mp4";
import oodInsertionHintCircle from "../assets/video/experiments/ood-insertion-hint-red-circle.mp4";

interface Metric {
  hint: number;
  pi: number;
  delta: number;
}

interface Rollout {
  method: "pi" | "hint";
  name: string;
  variant: string;
  src: string;
}

interface Task {
  id: string;
  label: string;
  title: string;
  description: string;
  metrics: {
    is: Metric;
    sub: Metric;
    full: Metric;
  };
  videos: Rollout[];
}

interface Props {
  setting: "id" | "ood";
}

const { setting } = Astro.props;

const idTasks: Task[] = [
  {
    id: "sorting",
    label: "Sorting",
    title: "Fruit-Vegetable Sorting",
    description:
      "Place fruits and vegetables into the baskets specified by color.",
    metrics: {
      is: { hint: 91.2, pi: 52.2, delta: 39.0 },
      sub: { hint: 91.2, pi: 52.2, delta: 39.0 },
      full: { hint: 60.0, pi: 10.0, delta: 50.0 },
    },
    videos: [
      { method: "pi", name: "π₀.₅", variant: "Red basket", src: idSortingPiRed },
      { method: "hint", name: "HINT", variant: "Red basket", src: idSortingHintRed },
      { method: "pi", name: "π₀.₅", variant: "Blue basket", src: idSortingPiBlue },
      { method: "hint", name: "HINT", variant: "Blue basket", src: idSortingHintBlue },
    ],
  },
  {
    id: "spelling",
    label: "Spelling",
    title: "Word Spelling",
    description:
      "Identify the word from the reference image, then spell it with letter blocks on the board.",
    metrics: {
      is: { hint: 97.9, pi: 44.7, delta: 53.2 },
      sub: { hint: 95.7, pi: 42.6, delta: 53.1 },
      full: { hint: 86.7, pi: 13.3, delta: 73.4 },
    },
    videos: [
      { method: "pi", name: "π₀.₅", variant: "WOLF", src: idSpellingPiWolf },
      { method: "hint", name: "HINT", variant: "WOLF", src: idSpellingHintWolf },
      { method: "pi", name: "π₀.₅", variant: "BOX", src: idSpellingPiBox },
      { method: "hint", name: "HINT", variant: "BOX", src: idSpellingHintBox },
    ],
  },
  {
    id: "insertion",
    label: "Insertion",
    title: "Peg-in-Hole Insertion",
    description:
      "Pick up the specified-color template, place it in the black tray, then insert the matching-shape peg.",
    metrics: {
      is: { hint: 100.0, pi: 35.0, delta: 65.0 },
      sub: { hint: 67.5, pi: 27.5, delta: 40.0 },
      full: { hint: 40.0, pi: 5.0, delta: 35.0 },
    },
    videos: [
      {
        method: "pi",
        name: "π₀.₅",
        variant: "Green · rectangle",
        src: idInsertionPiGreen,
      },
      {
        method: "hint",
        name: "HINT",
        variant: "Green · rectangle",
        src: idInsertionHintGreen,
      },
      {
        method: "pi",
        name: "π₀.₅",
        variant: "Red · L-shape",
        src: idInsertionPiRedL,
      },
      {
        method: "hint",
        name: "HINT",
        variant: "Red · L-shape",
        src: idInsertionHintRedL,
      },
    ],
  },
];

const oodTasks: Task[] = [
  {
    id: "sorting",
    label: "Sorting",
    title: "Fruit-Vegetable Sorting",
    description:
      "Place fruits and vegetables into the bowls specified by spatial relations.",
    metrics: {
      is: { hint: 82.6, pi: 56.5, delta: 26.1 },
      sub: { hint: 80.4, pi: 52.2, delta: 28.2 },
      full: { hint: 30.0, pi: 0.0, delta: 30.0 },
    },
    videos: [
      { method: "pi", name: "π₀.₅", variant: "Left", src: oodSortingPiLeft },
      { method: "hint", name: "HINT", variant: "Left", src: oodSortingHintLeft },
      { method: "pi", name: "π₀.₅", variant: "Right", src: oodSortingPiRight },
      { method: "hint", name: "HINT", variant: "Right", src: oodSortingHintRight },
    ],
  },
  {
    id: "spelling",
    label: "Spelling",
    title: "Word Spelling",
    description:
      "Identify the word from a novel reference, then spell it with unseen letter blocks.",
    metrics: {
      is: { hint: 95.5, pi: 40.9, delta: 54.6 },
      sub: { hint: 87.5, pi: 36.4, delta: 51.1 },
      full: { hint: 30.0, pi: 0.0, delta: 30.0 },
    },
    videos: [
      { method: "pi", name: "π₀.₅", variant: "APPLE", src: oodSpellingPiApple },
      { method: "hint", name: "HINT", variant: "APPLE", src: oodSpellingHintApple },
      { method: "pi", name: "π₀.₅", variant: "ROBOT", src: oodSpellingPiRobot },
      { method: "hint", name: "HINT", variant: "ROBOT", src: oodSpellingHintRobot },
    ],
  },
  {
    id: "insertion",
    label: "Insertion",
    title: "Peg-in-Hole Insertion",
    description:
      "Place the specified template by novel color or spatial relation, then insert the matching-shape peg.",
    metrics: {
      is: { hint: 90.0, pi: 26.7, delta: 63.3 },
      sub: { hint: 55.0, pi: 20.0, delta: 35.0 },
      full: { hint: 30.0, pi: 0.0, delta: 30.0 },
    },
    videos: [
      {
        method: "pi",
        name: "π₀.₅",
        variant: "Middle · rectangle",
        src: oodInsertionPiMiddle,
      },
      {
        method: "hint",
        name: "HINT",
        variant: "Middle · rectangle",
        src: oodInsertionHintMiddle,
      },
      {
        method: "pi",
        name: "π₀.₅",
        variant: "Red · circle",
        src: oodInsertionPiCircle,
      },
      {
        method: "hint",
        name: "HINT",
        variant: "Red · circle",
        src: oodInsertionHintCircle,
      },
    ],
  },
];

const tasks = setting === "id" ? idTasks : oodTasks;
const settingKicker = setting === "id" ? "In-distribution" : "Out-of-distribution";

const metricCards = [
  { key: "is" as const, label: "Intention Score", short: "IS" },
  { key: "sub" as const, label: "Subtask Success Rate", short: "Sub. SR" },
  { key: "full" as const, label: "Full-Task Success Rate", short: "Full SR" },
];
---

<div
  class="experiment-demos experiment-panel not-prose"
  data-setting={setting}
>
  <div
    class="border-b border-zinc-100 bg-gradient-to-br from-blue-50/80 via-white to-zinc-50 px-5 py-5 sm:px-8 sm:py-6 dark:border-zinc-800 dark:from-blue-950/30 dark:via-zinc-950 dark:to-zinc-950"
  >
    <div
      class="flex flex-wrap justify-center gap-2"
      role="tablist"
      aria-label={`${settingKicker} tasks`}
    >
      {
        tasks.map((task, index) => (
          <button
            type="button"
            data-task-btn={task.id}
            aria-selected={index === 0 ? "true" : "false"}
            class="rounded-full border border-zinc-200 bg-white px-5 py-2.5 text-sm font-semibold text-zinc-600 shadow-sm transition-all hover:border-blue-300 hover:text-blue-700 aria-selected:border-transparent aria-selected:bg-blue-600 aria-selected:text-white aria-selected:shadow-md aria-selected:hover:bg-blue-700 aria-selected:hover:text-white dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-blue-500 dark:aria-selected:bg-blue-500 dark:aria-selected:text-zinc-950"
          >
            {task.label}
          </button>
        ))
      }
    </div>
  </div>

  {
    tasks.map((task, index) => (
      <div
        data-task-panel={task.id}
        class:list={[index === 0 ? "block" : "hidden"]}
        role="tabpanel"
      >
        <div class="grid grid-cols-1 gap-4 px-5 py-5 sm:grid-cols-3 sm:px-8">
          {metricCards.map((card) => {
            const metric = task.metrics[card.key];
            const width = Math.max(8, Math.min(100, metric.hint));
            return (
              <div class="rounded-2xl border border-zinc-200 bg-white px-5 py-5 shadow-[0_10px_30px_-22px_rgba(15,23,42,0.4)] dark:border-zinc-800 dark:bg-zinc-900">
                <p class="m-0 text-[11px] font-semibold tracking-[0.16em] text-zinc-400 uppercase">
                  {card.short}
                </p>
                <p class="mt-2 mb-0 text-[2rem] leading-none font-semibold tracking-tight text-blue-700 dark:text-blue-300">
                  +{metric.delta.toFixed(1)}
                  <span class="ml-1 text-sm font-medium text-zinc-400">pp</span>
                </p>
                <p class="mt-2 mb-3 text-sm text-zinc-500 dark:text-zinc-400">
                  {card.label} vs π<sub>0.5</sub>
                </p>
                <div class="h-1.5 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-blue-500 to-sky-400"
                    style={`width: ${width}%`}
                  />
                </div>
                <p class="mt-2 mb-0 text-xs text-zinc-500">
                  {metric.pi.toFixed(1)}% →{" "}
                  <span class="font-semibold text-zinc-800 dark:text-zinc-200">
                    {metric.hint.toFixed(1)}%
                  </span>
                </p>
              </div>
            );
          })}
        </div>

        <div class="border-t border-zinc-100 px-3 pt-4 pb-3 sm:px-4 sm:pt-5 sm:pb-4 dark:border-zinc-800">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2 px-1">
            <p class="m-0 text-sm font-semibold text-zinc-800 dark:text-zinc-100">
              {task.title}
              <span class="ml-2 font-normal text-zinc-400">
                {task.description}
              </span>
            </p>
            <span class="inline-flex rounded-full bg-blue-600 px-2.5 py-1 text-[10px] font-semibold tracking-[0.14em] text-white uppercase">
              {settingKicker}
            </span>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {task.videos.map((item) => {
              const ours = item.method === "hint";
              return (
                <article
                  class:list={[
                    "overflow-hidden rounded-2xl border",
                    ours
                      ? "border-emerald-300 shadow-[0_12px_32px_-20px_rgba(16,185,129,0.55)] dark:border-emerald-700"
                      : "border-zinc-200 dark:border-zinc-800",
                  ]}
                >
                  <div class="bg-black">
                    <video
                      class="experiment-rollout-video w-full bg-black object-contain"
                      src={item.src}
                      aria-label={`${task.title}: ${item.name} ${item.variant}`}
                      controls
                      loop
                      muted
                      playsinline
                      autoplay
                      preload="metadata"
                    />
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  const pauseVideos = (root: HTMLElement) => {
    root.querySelectorAll<HTMLVideoElement>("video").forEach((video) => {
      video.pause();
    });
  };

  const playVisible = (root: HTMLElement) => {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduceMotion) return;

    root.querySelectorAll<HTMLElement>("[data-task-panel]").forEach((panel) => {
      const active = !panel.classList.contains("hidden");
      panel.querySelectorAll<HTMLVideoElement>("video").forEach((video) => {
        if (active) {
          void video.play().catch(() => undefined);
        } else {
          video.pause();
        }
      });
    });
  };

  const activate = (root: HTMLElement, taskId: string) => {
    root.querySelectorAll<HTMLButtonElement>("[data-task-btn]").forEach((btn) => {
      btn.setAttribute(
        "aria-selected",
        btn.dataset.taskBtn === taskId ? "true" : "false",
      );
    });

    root.querySelectorAll<HTMLElement>("[data-task-panel]").forEach((panel) => {
      const active = panel.dataset.taskPanel === taskId;
      panel.classList.toggle("hidden", !active);
      panel.classList.toggle("block", active);
    });

    pauseVideos(root);
    playVisible(root);
  };

  document.querySelectorAll<HTMLElement>(".experiment-demos").forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>("[data-task-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const taskId = btn.dataset.taskBtn;
        if (taskId) activate(root, taskId);
      });
    });

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduceMotion) {
      root.querySelectorAll<HTMLVideoElement>("video").forEach((video) => {
        video.removeAttribute("autoplay");
        video.pause();
      });
      return;
    }

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) playVisible(root);
            else pauseVideos(root);
          }
        },
        { threshold: 0.2 },
      );
      observer.observe(root);
    }
  });
</script>
