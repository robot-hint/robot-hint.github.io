---
import { Picture as AstroPicture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
  fill?: boolean;
}

const {
  src,
  alt,
  priority = false,
  invertInDarkMode = false,
  fill = false,
} = Astro.props;
---

<AstroPicture
  class:list={[
    "max-w-full",
    fill
      ? "block h-auto w-full"
      : "mx-auto max-h-[calc(100svh-3rem)] w-min",
    invertInDarkMode && "dark:invert",
  ]}
  src={src}
  alt={alt}
  layout={fill ? "full-width" : "constrained"}
  formats={["avif"]}
  priority={priority}
  fit="contain"
/>
